SECRET_KEY=dev-secret-key-sistema-relatorios-2026
DATABASE_URL=sqlite:///sistema_relatorios.db
FLASK_ENV=development

# Configurações de E-mail (SMTP)
# Para modo de produção, preencha com as credenciais reais:
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=seu_email@exemplo.com
SMTP_PASSWORD=sua_senha_ou_app_password
SMTP_DEFAULT_SENDER=Sistema de Relatórios <seu_email@exemplo.com>
# MODO SIMULAÇÃO: Se True, registra o e-mail no banco e simula envio sem falhar se não houver credenciais reais
SMTP_SIMULATION_MODE=True
